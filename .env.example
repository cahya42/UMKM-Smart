# Konfigurasi publik untuk aktivasi lisensi.
# Keduanya AMAN ada di frontend: alamat server dan kunci PUBLIK.
# Jangan pernah menaruh private key atau rahasia server di file ini.

# Alamat dasar layanan lisensi (HTTPS). Contoh: https://lisensi.contoh.id
VITE_LICENSE_API_URL=

# Kunci publik ECDSA P-256 dalam format JWK satu baris (JSON).
# Nilai ini harus cocok dengan private key yang disimpan di server lisensi.
# Contoh bentuk: {"kty":"EC","crv":"P-256","x":"...","y":"..."}
VITE_LICENSE_PUBLIC_KEY_JWK=
